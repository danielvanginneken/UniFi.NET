<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <PackageId>UniFi.Mobility.Client</PackageId>
    <Version>1.0.0</Version>
    <Description>A .NET client for the UniFi Mobility API (api.ui.com), covering workspaces, mobile routing devices (UMR), their clients, and device configuration.</Description>
    <Authors>Daniël van Ginneken</Authors>
    <RepositoryUrl>https://github.com/danielvanginneken/UniFi.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/danielvanginneken/UniFi.NET</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
